type Company {
     company: {
         name: string
         departments: {
             dept_name: string
             employees: {
                 name: string
                 role: string
                 salary?: number
             }[]
         }[]
     }
 }

agent TestCompany{
    default config{
         model: groq("openai/gpt-oss-120b",{
             temperature: 0
        })
        prompt: "Be polite and concise"
    }
    output: Company
}
