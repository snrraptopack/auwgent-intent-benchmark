

type Usr{
    name: string,
    age: number
    country: string
    is_student?: boolean
 }


agent TestUser{
    default config{
        model: groq("openai/gpt-oss-120b",{
            temperature: 0
        })
        prompt: """Your output must match [schema:type] ... [/schema]"""
    }
    output:Usr
}
