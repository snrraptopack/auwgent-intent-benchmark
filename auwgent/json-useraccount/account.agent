

type UserAccount{
    person: {
        id: string
        email: string
  }
  account: {
        plan: "free" | "pro" | "enterprise"
        active: boolean
    }
 }


agent TestAccount{
    default config{
        model: groq("openai/gpt-oss-120b")
        prompt: "Be polite and concise"
    }
    output:UserAccount
}
