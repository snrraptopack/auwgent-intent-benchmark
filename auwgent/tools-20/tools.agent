
agent TestAccount{
    default config{
        model: custom("groq-api","https://api.groq.com/openai/v1","llama-3.3-70b-versatile")
        prompt: "Be polite and concise"
    }
    tool read_todo(id:string):string
    @desc "read the content of a todo by its id"

    tool create_todo(title:string, due_date:string
    @desc "ISO 8601 date string", priority:"low"|"medium"|"high"):string @desc "create a new todo and return its id"

    tool delete_todo(id:string):boolean
    @desc "permanently delete a todo by id"

    tool mark_todo_done(id:string):boolean
    @desc "mark a todo as completed"

    tool update_todo_title(id:string, new_title:string):boolean
    @desc "rename a todo item"

    tool set_todo_priority(id:string, priority:"low"|"medium"|"high"):boolean
    @desc "change the priority of a todo"

    tool count_todos(filter:"all"|"done"|"pending"):number
    @desc "count todos matching a status filter"

    tool get_user_name(user_id:string):string
    @desc "get the display name of a user"

    tool get_user_email(user_id:string):string
    @desc "get the email address of a user"

    tool update_user_email(user_id:string, new_email:string):boolean
    @desc "update the email address for a user"

    tool check_user_exists(user_id:string):boolean
    @desc "check whether a user account exists"

    tool deactivate_user(user_id:string):boolean
    @desc "deactivate a user account"

    tool get_user_role(user_id:string):string
    @desc "return the role assigned to a user"

    tool assign_user_role(user_id:string, role:"admin"|"editor"|"viewer"):boolean
    @desc "assign a role to a user"

    tool send_email(to:string, subject:string, body:string):boolean
    @desc "send an email and confirm delivery"

    tool get_email_subject(message_id:string):string
    @desc "return the subject line of an email"

    tool mark_email_read(message_id:string):boolean
    @desc "mark an email message as read"

    tool delete_email(message_id:string):boolean
    @desc "delete an email by its message id"

    tool schedule_meeting(title:string, start_iso:string @desc "ISO 8601 datetime", duration_minutes:number):string
    @desc "schedule a meeting and return its event id"

    tool cancel_meeting(event_id:string, reason:string):boolean
    @desc "cancel a calendar event"
}
