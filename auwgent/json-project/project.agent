
type Project{
     project_name: string
     tasks: {
         title: string
         priority: "low" | "medium" | "high"
         completed?: boolean
     }[]
}

agent TestProject{
    default config{
        model: groq("openai/gpt-oss-120b",{
             temperature: 0
        })
        prompt: "Be polite and concise"
    }
    output: Project
}
